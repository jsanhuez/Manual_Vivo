{
  "name": "manual-vivo-api",
  "version": "0.4.0",
  "description": "API REST de Manual Vivo",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prebuild": "prisma generate",
    "build": "nest build",
    "start": "nest start",
    "prestart:dev": "prisma generate",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db execute --file prisma/seed.sql --schema prisma/schema.prisma",
    "db:reset": "prisma migrate reset --force --skip-seed --skip-generate && npm run db:seed",
    "db:diff": "prisma migrate diff --from-schema-datasource prisma/schema.prisma --to-schema-datamodel prisma/schema.prisma --exit-code"
  },
  "dependencies": {
    "@nestjs/common": "11.2.9",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.9",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.9",
    "@nestjs/throttler": "6.7.1",
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "helmet": "8.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "prisma": "6.19.3",
    "typescript": "5.9.3"
  }
}
