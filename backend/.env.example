# Copia este archivo como .env, en Render las mismas variables se definen en Environment

# Desarrollo local con docker compose up -d db
DATABASE_URL="postgresql://postgres:mv_dev_2026@localhost:55432/manual_vivo"
DIRECT_URL="postgresql://postgres:mv_dev_2026@localhost:55432/manual_vivo"

# En Supabase: DATABASE_URL usa el pooler de transacciones (puerto 6543) y DIRECT_URL el pooler de sesión (puerto 5432)
# DATABASE_URL="postgresql://postgres.<ref>:<clave>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"
# DIRECT_URL="postgresql://postgres.<ref>:<clave>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Mínimo 32 caracteres, por ejemplo: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="cambia-esta-clave-por-una-aleatoria-de-al-menos-32-caracteres"

# Origen del frontend para CORS y para los enlaces de los correos, se admiten varios separados por coma
FRONTEND_URL="http://localhost:5173"

# Render define PORT automáticamente
PORT=3000

# Solicitudes por minuto e IP: general y para inicio de sesión y recuperación de contraseña
THROTTLE_LIMIT=3000
AUTH_THROTTLE_LIMIT=20

# Correo transaccional por la API HTTPS de Brevo, sin BREVO_API_KEY los correos quedan en el log
BREVO_API_URL="https://api.brevo.com/v3/smtp/email"
BREVO_API_KEY=""
MAIL_FROM=""
MAIL_FROM_NAME="Manual Vivo"
